# ── autoresearch environment variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env   (Linux/Mac)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Most keys are only required if you use the corresponding tool.

# ── Required for backend integration ─────────────────────────────────────────────
# Absolute path to this autoresearch directory (set in manageesg-backend .env too)
# Windows example:  AUTORESEARCH_DIR=C:\Users\YourName\SeaBridgeAI\autoresearch
# Linux/Mac example: AUTORESEARCH_DIR=/home/yourname/SeaBridgeAI/autoresearch
AUTORESEARCH_DIR=

# ── Required for Feynman (research briefs) ────────────────────────────────────────
# At least one of these must be set (Feynman also reads from feynman/.env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Required for Paper2Agent / deep research ─────────────────────────────────────
# Paper2Agent costs $2–10 per run. Requires explicit written approval.
# ANTHROPIC_API_KEY (above) is used.

# ── Optional: ML training loop (autoresearch) ─────────────────────────────────────
# Only needed for the Karpathy ML training loop (train.py / prepare.py)
# No extra env vars required beyond a working Python + CUDA environment.

# ── Optional: Streamlit UI ───────────────────────────────────────────────────────
# No extra env vars required; inherits keys above via the shell environment.
